# Variables d'environnement MarketTrend
# Copier ce fichier en .env.local pour le développement local
# Sur Vercel : Settings > Environment Variables

# Finnhub API Key — pour les news avec sentiment
# Plan gratuit : https://finnhub.io (60 req/min)
FINNHUB_API_KEY=

# CoinGecko Pro API Key — optionnel
# Le plan gratuit (sans clé) fonctionne déjà
COINGECKO_API_KEY=
